# Copy this file to .env and fill in your Supabase project values.
# Vite only exposes variables prefixed with VITE_ to the client.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Image upload: URL of the Cloudflare Worker that commits photos to the GitHub
# repo (public/photos) so they are served from this site's own build output.
VITE_IMAGE_UPLOAD_URL=https://menu-image-store.<your-account-subdomain>.workers.dev

# ---------------------------------------------------------------------------
# Expected Supabase table (run in the Supabase SQL editor):
#
# create table public.orders (
#   id uuid primary key default gen_random_uuid(),
#   created_at timestamptz not null default now(),
#   table_number text not null,
#   customer_name text not null,
#   notes text not null default '',
#   payment_method text not null default 'waiter',
#   items jsonb not null,
#   total numeric not null,
#   status text not null default 'pending'
# );
#
# -- Allow anonymous inserts from the storefront (adjust to your needs):
# alter table public.orders enable row level security;
# create policy "allow anon insert" on public.orders
#   for insert to anon with check (true);
#
# Menu storage (Supabase): run the bundled SQL files in order.
#   1. supabase/menu-schema.sql   -- creates categories + menu tables (incl.
#      availability window columns available_from/available_to), enables RLS
#   2. supabase/menu-seed.sql     -- populates them from public/menu.json
#
# When VITE_SUPABASE_* are set, the menu is read from these tables. When they
# are missing the app falls back to public/menu.json (demo mode). menu.json is
# kept in the repo only as the source/fallback seed.
# ---------------------------------------------------------------------------
